// Phosphor-95 // fastfetch — generated, edit src/
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "{{ text.fg_dim | sgr }}", "2": "{{ text.glow | sgr }}", "3": "{{ text.fg | sgr }}" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "{{ text.fg_dim | sgr }}", "title": "{{ text.glow | sgr }}", "output": "{{ text.fg | sgr }}" },
    "key": { "width": 13 },
    "bar": { "char": { "elapsed": "▓", "total": "░" }, "width": 14 },
    "percent": { "type": 3, "color": { "green": "{{ text.fg | sgr }}", "yellow": "{{ status.warn | sgr }}", "red": "{{ status.error | sgr }}" } }
  },
  "modules": [
    { "type": "custom", "format": "{{ identity.name }} // {{ identity.tagline }}", "outputColor": "{{ text.glow | sgr }}" },
    { "type": "custom", "format": "────────────────────────────────────────", "outputColor": "{{ text.fg_faint | sgr }}" },
    { "type": "os",       "key": "SYS.OS" },
    { "type": "kernel",   "key": "SYS.KERNEL" },
    { "type": "host",     "key": "SYS.HOST" },
    { "type": "uptime",   "key": "SYS.UPTIME" },
    { "type": "shell",    "key": "SYS.SHELL" },
    { "type": "de",       "key": "SYS.DESKTOP" },
    { "type": "cpu",      "key": "HW.CPU", "temp": true },
    { "type": "gpu",      "key": "HW.GPU", "hideType": "integrated" },
    { "type": "memory",   "key": "HW.MEMORY", "percent": { "type": 3 } },
    { "type": "disk",     "key": "HW.DISK", "folders": "/", "percent": { "type": 3 } },
    { "type": "battery",  "key": "HW.POWER" },
    { "type": "localip",  "key": "NET.LOCAL", "showIpv6": false },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 2 }
  ]
}
